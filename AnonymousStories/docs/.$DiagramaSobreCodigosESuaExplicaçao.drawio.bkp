        <mxCell id="iefagswG0spB1CcRxWZt-16" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;font-size: 40px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;A pasta&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;font-size: 40px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;358&quot; data-start=&quot;350&quot;&gt;entity&lt;/code&gt;&lt;span style=&quot;font-size: 40px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;representa as&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 40px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;448&quot; data-start=&quot;373&quot;&gt;coisas que existem no sistema e que serão armazenadas no banco de dados&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 40px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
